# Neon Postgres connection string (Vercel's Neon integration sets this for you)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Clerk (from your Clerk dashboard > API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Site admins (set up families on the Families page), separated by commas or semicolons.
ADMIN_EMAILS=you@example.com
# Older setups: PARENT_EMAILS still works as the admin list, and marks who becomes a parent in the first family.
# PARENT_EMAILS=you@example.com
# Optional: name for the family created from existing accounts on upgrade
# FIRST_FAMILY_NAME=The Haid family

# Anthropic API key for turning study guides into quizzes (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model used to write quizzes
ANTHROPIC_MODEL=claude-sonnet-5-5
